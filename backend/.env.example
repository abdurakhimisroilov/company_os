# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_os
DB_USER=company_os_user
DB_PASSWORD=your_secure_password

# JWT Authentication
JWT_SECRET=your_very_long_random_secret_key_minimum_64_chars_company_os_jwt_secret_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_very_long_random_refresh_secret_company_os_jwt_refresh_token_2026
JWT_REFRESH_EXPIRES_IN=30d

# Application Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET_NAME=company-os

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
